# Copy to .env and fill in real values. Never commit the real .env file.

# Same Postgres instance the Java service uses - pgvector extension must be
# enabled: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_engineering

# Used by ChatAnthropic in rag_service.py to answer questions
ANTHROPIC_API_KEY=

# Where the Java service lives, so we can call back with index status
JAVA_SERVICE_URL=http://localhost:8080

# Optional - service-to-service shared secret for the index-status callback.
# MUST match java-service's INTERNAL_SERVICE_SECRET exactly - this is how
# java-service's /internal/repos/{id}/index-status endpoint authenticates
# calls from this service (it's not a user-JWT-protected endpoint, since
# this service isn't a logged-in user).
INTERNAL_SERVICE_SECRET=

PORT=8000
