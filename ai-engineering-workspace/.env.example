# Copy to .env (same directory as docker-compose.yml) and fill in real
# values, then run: docker compose up --build
#
# docker-compose.yml intentionally uses ${VAR:?message} for every secret -
# compose will refuse to start rather than silently fall back to an insecure
# default. That's deliberate: these are exactly the values flagged as
# security-critical in the implementation guide.

JWT_SECRET=                  # openssl rand -base64 32
ENCRYPTION_SECRET_KEY=       # openssl rand -base64 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# Must be the SAME value on both sides - this is how java-service and
# python-service authenticate each other's internal-only calls.
INTERNAL_SERVICE_SECRET=     # openssl rand -base64 32

# Where the OAuth callback sends the browser after login. Point this at
# wherever you're serving dev-tools/test-harness.html, or a real frontend
# later.
FRONTEND_URL=http://localhost:5500

# Comma-separated list of origins allowed to call java-service. "*" is fine
# for local dev; do not use "*" once this is reachable by anyone else.
CORS_ALLOWED_ORIGINS=*
